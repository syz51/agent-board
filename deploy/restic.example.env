# Copy to /etc/agent-board/restic.env (mode 0600) and fill in. Any S3-compatible store works.
RESTIC_REPOSITORY=s3:https://s3.example.com/your-bucket/agent-board
RESTIC_PASSWORD_FILE=/etc/agent-board/restic.password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Optional extra restic options, for example for virtual-hosted bucket names:
# BOARD_RESTIC_OPTIONS=-o s3.bucket-lookup=dns
