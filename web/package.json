{
  "name": "agent-board-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --watch dev/server.ts",
    "build": "bun run build.ts",
    "preview": "bun run build.ts && bun dev/server.ts --dist",
    "typecheck": "bun node_modules/typescript-native/bin/tsc --noEmit -p .",
    "lint": "bunx --bun eslint .",
    "format": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run build.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "marked": "18.1.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "typescript-native": "npm:typescript@7.0.2"
  }
}
