{
  "name": "agent-board-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch dev/server.ts",
    "build": "bun --bun vp build",
    "preview": "bun run build && bun dev/server.ts --dist",
    "typecheck": "bun --bun vp check --no-fmt --no-lint",
    "lint": "bun --bun vp lint",
    "format": "bun --bun vp fmt",
    "format:check": "bun --bun vp fmt --check",
    "test": "bun --bun vp test",
    "check": "bun --bun vp check && bun --bun vp test && bun --bun vp build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "marked": "18.3.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  },
  "packageManager": "bun@1.4.4"
