{
  "name": "agent-board-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --hot dev/server.ts",
    "build": "bun run build.ts",
    "preview": "bun run build.ts && bun dev/server.ts --dist",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "marked": "18.1.3",
    "preact": "11.1.1",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "preact-render-to-string": "6.8.2",
    "typescript": "7.0.2"
  }
}
